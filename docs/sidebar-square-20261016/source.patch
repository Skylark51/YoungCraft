+        setMinimumSize(120, 120);
+    }
+protected:
+    void resizeEvent(QResizeEvent *event) override {
+        QWidget::resizeEvent(event);
+        const int side = qMin(width(), height());
+        m_view->setGeometry((width() - side) / 2, (height() - side) / 2, side, side);
+    }
+private:
