+    explicit SquareMoleculeViewport(MoleculeView *view, QWidget *parent)
+        : QWidget(parent), m_view(view) {
+        setObjectName(QStringLiteral("SquareMoleculeViewport"));
+        setAutoFillBackground(true);
+        auto colors = palette();
+        colors.setColor(QPalette::Window, QColor(230, 232, 235));
