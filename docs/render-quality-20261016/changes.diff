+        combo->setCurrentText(QStringLiteral("CPK / Space-Filling"));
+        QVERIFY(scale->isEnabled()); scale->setValue(0.85);
+        QVERIFY(qAbs(window.m_view->style().spaceFillingScale - 0.85f) < 0.001f);
